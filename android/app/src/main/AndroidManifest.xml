<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Enlaces profundos. Con esto, tocar un enlace de invitación o de
              lista pública abre Kiemas en vez del navegador.

              android:autoVerify exige publicar
              https://kiemas.com/.well-known/assetlinks.json con la huella SHA-256
              del certificado de firma. Si la verificación falla, Android no rompe
              nada: el enlace sigue abriendo el navegador, simplemente no llega a
              activarse la apertura directa en la app.

              El dominio viejo de Vercel se mantiene a propósito. Hay enlaces de
              invitación y de listas ya repartidos por WhatsApp que lo llevan
              dentro, y Vercel mantiene vivo el subdominio para siempre: quitarlo
              de aquí solo serviría para que esos enlaces dejaran de abrir la app.

              `www.kiemas.com` NO va aquí, y no es un olvido. En Vercel redirige
              al dominio raíz con un 308, y la verificación de Android no sigue
              redirecciones: pediría el assetlinks.json, recibiría el 308 y daría
              ese host por fallido. A partir de Android 12 basta con que uno de
              los hosts del filtro falle para que no se verifique NINGUNO, así
              que dejarlo aquí tumbaría también a kiemas.com.

              Regla para cuando se añada otro dominio: solo entra si sirve
              /.well-known/assetlinks.json con un 200 directo.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="kiemas.com" />
                <data android:scheme="https" android:host="kopasymas.vercel.app" />
            </intent-filter>
        </activity>

        <!--
          Widget de pantalla de inicio. `exported="false"` porque solo lo invoca
          el sistema y nuestra propia app: ninguna otra tiene por qué poder
          disparar su actualización.
        -->
        <receiver
            android:name=".NextPlanWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_next_plan_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- El botón «mi ubicación» del mapa. Aproximada basta: se usa para centrar
         y para calcular distancias, no para navegar. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- El mapa necesita saber si hay conexión para no quedarse en blanco. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
</manifest>
