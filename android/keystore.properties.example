# Copia este fichero como `android/keystore.properties` y rellénalo.
#
# NO se sube al repositorio: contiene las contraseñas del almacén de claves.
#
# `storeFile` es la ruta al almacén, relativa a la carpeta `android/`.
# Si el fichero está en la raíz del proyecto, la ruta es `../kiemas.keystore`.

storeFile=../kedada.keystore
storePassword=
keyAlias=
keyPassword=
