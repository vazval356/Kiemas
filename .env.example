# Copia este fichero como `.env` y rellena los valores de tu proyecto Supabase.
# Project Settings > API en el panel de Supabase.

VITE_SUPABASE_URL=https://TUPROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Dirección pública desde la que se sirve la app.
#
# Es la base de los enlaces que se comparten fuera: invitaciones a un espacio y
# listas públicas. Hace falta porque dentro del contenedor de Capacitor
# `window.location.origin` vale `http://localhost`, así que sin esto todo enlace
# compartido desde el móvil llegaría roto a quien lo recibe — y en web parecería
# funcionar perfectamente.
#
# En desarrollo web puede quedarse vacía: se cae al origen actual.
VITE_PUBLIC_URL=https://kiemas.com

# Claves públicas de RevenueCat (Project settings > API keys en su panel).
#
# Son claves de cliente y van en el binario: no son secretas. La que sí lo es
# es la de servidor, que solo usa el webhook.
#
# Sin ellas la app funciona igual, pero sin botones de compra. Los códigos
# promocionales sí siguen funcionando, porque no pasan por RevenueCat.
VITE_REVENUECAT_ANDROID_KEY=
VITE_REVENUECAT_IOS_KEY=

# Proveedores de entrada social que están configurados, separados por comas.
#
# Los botones solo aparecen para los que se listen aquí. No es estética: cada
# proveedor hay que darlo de alta en su consola (Google Cloud, Apple Developer)
# y luego activarlo en Supabase. Un botón visible sin eso lleva a una pantalla
# de error del proveedor.
#
#   VITE_OAUTH_PROVIDERS=google,apple
VITE_OAUTH_PROVIDERS=

# Avisos en la web (la app instalada en la pantalla de inicio). Sin esto, el
# interruptor de Ajustes no aparece en el navegador y el SDK de Firebase ni
# siquiera se compila. Todo sale de la consola de Firebase:
#   · Configuración del proyecto → Tus apps → App web  (los cuatro primeros)
#   · Configuración del proyecto → Cloud Messaging → Certificados push web
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_PROJECT_ID=kedada-4ad5d
VITE_FIREBASE_SENDER_ID=1063256527462
VITE_FIREBASE_APP_ID=1:1063256527462:web:...
VITE_FIREBASE_VAPID_KEY=B...

# Medición de uso. Vacía = no se mide nada, que es como está hoy.
#
# ANTES DE RELLENARLA: la política de privacidad promete que no hay analítica
# de terceros. Encender esto sin corregir ese texto la convierte en falsa. Los
# pasos están en la cabecera de src/lib/analytics.ts.
VITE_ANALYTICS=
